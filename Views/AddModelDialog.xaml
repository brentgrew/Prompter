<Window x:Class="Prompter.Views.AddModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Local AI Model (Gemma, Llama, Ollama, GGUF)" Height="520" Width="520"
        Icon="pack://application:,,,/Prompter;component/prompter.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="➕ Add Local AI Model" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
            <TextBlock Text="Pull any model from Ollama (Gemma, Llama, DeepSeek, Mistral) or register a local .gguf file"
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Mode Tabs -->
        <Border Grid.Row="1" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnTabPull" Grid.Column="0" Content="🌐 Pull from Ollama"
                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                        BorderThickness="0" Click="TabPull_Click"/>
                <Button x:Name="btnTabGguf" Grid.Column="1" Content="📁 Register GGUF File"
                        Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                        BorderThickness="0" Click="TabGguf_Click"/>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="2">
            <!-- TAB 1: PULL FROM OLLAMA -->
            <StackPanel x:Name="panelPull" Visibility="Visible">
                <TextBlock Text="Model Name / Tag:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtModelName" Text="gemma:2b" Margin="0,0,0,10"/>

                <!-- Quick Presets -->
                <TextBlock Text="Popular Models (Click to select):" FontSize="11.5" Foreground="{DynamicResource TextSubtleBrush}" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button Content="💎 gemma:2b" Margin="0,0,6,6" Background="{DynamicResource DialogCardBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Preset_Click" Tag="gemma:2b"/>
                    <Button Content="💎 gemma2:9b" Margin="0,0,6,6" Background="{DynamicResource DialogCardBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Preset_Click" Tag="gemma2:9b"/>
                    <Button Content="🦙 llama3.2:1b" Margin="0,0,6,6" Background="{DynamicResource DialogCardBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Preset_Click" Tag="llama3.2:1b"/>
                    <Button Content="🦙 llama3.2:3b" Margin="0,0,6,6" Background="{DynamicResource DialogCardBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Preset_Click" Tag="llama3.2:3b"/>
                    <Button Content="🌪️ mistral:7b" Margin="0,0,6,6" Background="{DynamicResource DialogCardBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Preset_Click" Tag="mistral:7b"/>
                    <Button Content="🐋 deepseek-r1:1.5b" Margin="0,0,6,6" Background="{DynamicResource DialogCardBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Preset_Click" Tag="deepseek-r1:1.5b"/>
                    <Button Content="⭐ qwen2.5:1.5b" Margin="0,0,6,6" Background="{DynamicResource DialogCardBackgroundBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Preset_Click" Tag="qwen2.5:1.5b"/>
                </WrapPanel>

                <!-- Status Progress -->
                <Border Background="{DynamicResource DialogCardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="txtStatus" Text="Ready to download model from Ollama library." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="prgPull" Height="6" Margin="0,8,0,0" IsIndeterminate="False" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- TAB 2: REGISTER GGUF -->
            <StackPanel x:Name="panelGguf" Visibility="Collapsed">
                <TextBlock Text="Local GGUF File Path:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtGgufPath" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="📁 Browse..." Margin="8,0,0,0"
                            Background="{DynamicResource OutlineButtonBackgroundBrush}"
                            Foreground="{DynamicResource OutlineButtonForegroundBrush}"
                            BorderBrush="{DynamicResource OutlineButtonBorderBrush}"
                            BorderThickness="1" Click="BrowseGguf_Click"/>
                </Grid>

                <TextBlock Text="Ollama Model Identifier Name:" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextHeadingBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtGgufModelName" Margin="0,0,0,16"/>

                <Border Background="{DynamicResource DialogCardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <TextBlock Text="Prompter will register this GGUF file with Ollama's local engine so you can chat with it directly."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancel" Content="Close"
                    Background="{DynamicResource OutlineButtonBackgroundBrush}"
                    Foreground="{DynamicResource OutlineButtonForegroundBrush}"
                    BorderBrush="{DynamicResource OutlineButtonBorderBrush}"
                    BorderThickness="1" Margin="0,0,10,0" Click="Close_Click"/>
            <Button x:Name="btnAction" Content="📥 Download Model"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    Foreground="#FFFFFF" BorderThickness="0" Click="Action_Click"/>
        </StackPanel>
    </Grid>
</Window>
