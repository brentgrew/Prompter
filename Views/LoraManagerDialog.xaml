<Window x:Class="Prompter.Views.LoraManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Prompter.Converters"
        Title="LoRA Manager — SwarmUI Models (X:\SwarmUI\Models\Lora)"
        Height="720" Width="1020" MinWidth="850" MinHeight="550"
        Icon="pack://application:,,,/Prompter;component/prompter.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        <conv:CountToVisibilityConverter x:Key="InvertCountToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetWeightButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DialogCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filters / Search Toolbar -->
            <RowDefinition Height="*"/>    <!-- Dual List Body -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧬" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SwarmUI LoRA Manager" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextHeadingBrush}"/>
                </StackPanel>
                <TextBlock Text="Select LoRAs from your library (X:\SwarmUI\Models\Lora) and configure strength weights for image generation."
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="28,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Background="{DynamicResource DialogCardBackgroundBrush}"
                        Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Padding="10,6" ToolTip="Re-scan LoRA models from SwarmUI API and disk">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh Library" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- TOOLBAR: SEARCH & FOLDER FILTER -->
        <Border Grid.Row="1" Background="{DynamicResource DialogCardBackgroundBrush}"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource TextSubtleBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter by LoRA filename, title, folder, or trigger words"/>
                </Grid>

                <!-- Folder Filter Dropdown -->
                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Folder: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Folders}"
                              SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                              Height="30" VerticalContentAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- DUAL LIST MAIN BODY -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <!-- COLUMN A: ACTIVE LORAS -->
                <ColumnDefinition Width="1.15*" MinWidth="320"/>
                <!-- MIDDLE ACTION BUTTONS -->
                <ColumnDefinition Width="80"/>
                <!-- COLUMN B: AVAILABLE LORAS LIBRARY -->
                <ColumnDefinition Width="1.3*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ================= COLUMN A: ACTIVE LORAS ================= -->
            <Border Grid.Column="0" Background="{DynamicResource DialogCardBackgroundBrush}"
                    CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & summary -->
                        <RowDefinition Height="*"/>    <!-- List -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ COLUMN A: ACTIVE LORAS" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextHeadingBrush}"/>
                            <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="10" Padding="7,1" Margin="8,0,0,0"
                                    Visibility="{Binding HasActiveLoras, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ActiveCountSummary}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ClearAllActiveCommand}"
                                Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                Padding="6,2" FontSize="11" Content="Clear All"
                                Visibility="{Binding HasActiveLoras, Converter={StaticResource BoolToVis}}"
                                ToolTip="Remove all LoRAs from active generation"/>
                    </DockPanel>

                    <!-- Empty State for Column A -->
                    <Border Grid.Row="1" Background="#0B0F19" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding HasActiveLoras, Converter={StaticResource InvertBoolToVis}}" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🧬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                            <TextBlock Text="No Active LoRAs Selected" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextHeadingBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Select LoRAs from Column B on the right and click [◀ Add] or double-click to activate them with custom weights."
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="280"/>
                        </StackPanel>
                    </Border>

                    <!-- Active LoRAs List -->
                    <ListBox x:Name="lstActiveLoras" Grid.Row="1" ItemsSource="{Binding ActiveLoras}"
                             SelectedItem="{Binding SelectedActiveLora, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasActiveLoras, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="8" Padding="12,10"
                                        BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Top Row: Title, Badges, Remove Button -->
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding DataContext.RemoveLoraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="#EF4444"
                                                    Padding="6,2" FontSize="12" ToolTip="Remove from active LoRAs"
                                                    Content="✕"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🧬 " FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                           ToolTip="{Binding Name}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Badge Row: Architecture & Folder -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <Border Background="#3B82F6" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ArchitectureBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <Border Background="#334155" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Folder, StringFormat='📁 {0}'}" FontSize="10" Foreground="#94A3B8"/>
                                            </Border>
                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <!-- STRENGTH CONFIGURATION SECTION -->
                                        <Border Background="#0F172A" CornerRadius="6" Padding="10,8" BorderBrush="#1E293B" BorderThickness="1">
                                            <StackPanel>
                                                <!-- Strength Slider & Numeric Input -->
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Strength / Weight:" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBox Text="{Binding StrengthFormatted, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 Width="48" Height="24" FontSize="11" FontWeight="Bold"
                                                                 TextAlignment="Center" Padding="2,1"
                                                                 ToolTip="Directly enter weight (e.g. 0.85)"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Slider Control (0.0 to 2.0 with 0.05 step) -->
                                                <Slider Minimum="0.0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                                        TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                        Value="{Binding Strength, Mode=TwoWay}"
                                                        Margin="0,0,0,6"/>

                                                <!-- Quick Preset Buttons -->
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="Presets: " FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Button Style="{StaticResource PresetWeightButton}" Content="0.5" Click="SetStrengthPreset_Click" Tag="0.50"/>
                                                    <Button Style="{StaticResource PresetWeightButton}" Content="0.7" Click="SetStrengthPreset_Click" Tag="0.70"/>
                                                    <Button Style="{StaticResource PresetWeightButton}" Content="0.85" Click="SetStrengthPreset_Click" Tag="0.85"/>
                                                    <Button Style="{StaticResource PresetWeightButton}" Content="1.0" Click="SetStrengthPreset_Click" Tag="1.00"/>
                                                    <Button Style="{StaticResource PresetWeightButton}" Content="1.25" Click="SetStrengthPreset_Click" Tag="1.25"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ================= MIDDLE CONTROLS ================= -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Command="{Binding AddLoraCommand}"
                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                        BorderThickness="0" Margin="0,0,0,12" Padding="8,10"
                        ToolTip="Move selected LoRA from Column B to Active Column A">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="◀" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Add" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding RemoveLoraCommand}"
                        Background="{DynamicResource DialogCardBackgroundBrush}"
                        Foreground="{DynamicResource TextBodyBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Padding="8,10"
                        ToolTip="Remove selected LoRA from Active Column A">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="▶" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Remove" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ================= COLUMN B: AVAILABLE LORAS LIBRARY ================= -->
            <Border Grid.Column="2" Background="{DynamicResource DialogCardBackgroundBrush}"
                    CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Count -->
                        <RowDefinition Height="*"/>    <!-- List -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📚 COLUMN B: AVAILABLE LORAS" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextHeadingBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FilteredAvailableCount, StringFormat='Showing {0} models'}"
                                   FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Available LoRAs List Grouped by Folder -->
                    <ListBox x:Name="lstAvailableLoras" Grid.Row="1" ItemsSource="{Binding AvailableLorasView}"
                             SelectedItem="{Binding SelectedAvailableLora, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="AvailableLora_MouseDoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,8,0,4">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name, StringFormat='📁 {0}'}"
                                                           FontWeight="Bold" FontSize="11.5" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}"
                                                           FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bdr" Background="#0F172A" CornerRadius="6" Padding="10,8"
                                                    BorderBrush="#1E293B" BorderThickness="1" Margin="0,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                    <Setter TargetName="bdr" Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bdr" Property="BorderBrush" Value="#475569"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- Add button on right -->
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding DataContext.AddLoraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                            BorderThickness="0" Padding="8,3" FontSize="11" VerticalAlignment="Center"
                                            Content="+ Add" ToolTip="Add to active LoRAs (Column A)"/>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource WindowForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Margin="0,3,0,0">
                                            <Border Background="#3B82F6" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding ArchitectureBadge}" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock Text="{Binding Folder, StringFormat='in {0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="10" Foreground="{DynamicResource TextSubtleBrush}"
                                                       VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding TriggerPhrase, StringFormat='Triggers: {0}'}"
                                                   FontSize="9.5" Foreground="#A5B4FC" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding TriggerPhrase, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Cancel" IsCancel="True" Background="Transparent"
                        Foreground="{DynamicResource TextMutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="✓ Apply &amp; Save LoRAs" IsDefault="True"
                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                        BorderThickness="0" Padding="18,8" Click="Apply_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
